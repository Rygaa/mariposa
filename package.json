{
  "name": "mariposa",
  "version": "1.0.0",
  "private": true,
  "description": "Mariposa project with backend and frontend",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev  --port 5174",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:studio": "pnpm --filter backend db:studio",
    "docker:start": "pnpm docker:launch",
    "docker:stop": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:prod": "pnpm docker:launch",
    "docker:launch": "node scripts/database.cjs launch",
    "db:backup": "node scripts/database.cjs backup",
    "db:move": "node scripts/database.cjs move"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
